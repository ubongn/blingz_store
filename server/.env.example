# Required
JWT_SECRET=your-super-secret-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/blingzstore
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# Server
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
